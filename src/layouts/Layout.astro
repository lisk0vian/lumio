---
import "../styles/global.css";
import { useTranslations, type AppLang } from "../i18n";

const {
  lang = "es",
  title = "Lumio",
  description,
} = Astro.props as { lang?: AppLang; title?: string; description?: string };
const t = useTranslations(lang);
// Lighthouse SEO flagged the missing description on every route; each page can
// still override it.
const metaDescription = description ?? t("meta.description");
// Base-aware asset URLs: `/` in dev, `/lumio/` in the GitHub Pages build.
// Favicons go through it at render time; the inline service-worker script
// below reads it back from `document.body.dataset.base` (is:inline scripts
// are emitted as-is, so import.meta.env is not available inside them).
const base = import.meta.env.BASE_URL ?? '/';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={`${base}zap.svg`} />
    <link rel="icon" href={`${base}zap.ico`} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={metaDescription} />
    <script is:inline>
      const prefersDark = window.matchMedia(
        "(prefers-color-scheme: dark)",
      ).matches;
      if (
        localStorage.theme === "dark" ||
        (!("theme" in localStorage) && prefersDark)
      ) {
        document.documentElement.classList.add("dark");
      } else {
        document.documentElement.classList.remove("dark");
      }

      window
        .matchMedia("(prefers-color-scheme: dark)")
        .addEventListener("change", (e) => {
          if (!("theme" in localStorage)) {
            document.documentElement.classList.toggle("dark", e.matches);
          }
        });

      // Single theme-toggle handler for the whole page (delegated, no
      // framework): every `[data-theme-toggle]` button — the Astro one in
      // TopBar and the React one inside MobileTabs — works before and
      // without hydration. Clicking persists localStorage.theme, which opts
      // out of following the OS preference.
      document.addEventListener("click", (e) => {
        const target = e.target;
        const button =
          target instanceof Element
            ? target.closest("[data-theme-toggle]")
            : null;
        if (!button) return;
        const dark = document.documentElement.classList.toggle("dark");
        try {
          localStorage.theme = dark ? "dark" : "light";
        } catch {
          // storage unavailable (private mode): theme still applies to the session
        }
      });
    </script>
    <script is:inline>
      // Service worker (public/sw.js): cache-first para assets con hash y
      // stale-while-revalidate para navegaciones. Solo en producción: en
      // `astro dev` rompería el HMR sirviendo copias viejas.
      // Base-aware: el SW vive bajo el base path en Pages (/lumio/sw.js con
      // scope /lumio/), y en la raíz en dev (/sw.js). Se lee desde
      // document.body.dataset.base, que Layout renderiza desde
      // import.meta.env.BASE_URL.
      if ("serviceWorker" in navigator) {
        window.addEventListener("load", () => {
          const hostname = window.location.hostname;
          const isLocal =
            hostname === "localhost" ||
            hostname === "127.0.0.1" ||
            hostname === "[::1]";
          if (!isLocal) {
            const rawBase =
              document.body?.dataset.base || "/";
            const base = rawBase.endsWith("/") ? rawBase : `${rawBase}/`;
            navigator.serviceWorker
              .register(`${base}sw.js`, { scope: base })
              .catch(() => {});
          }
        });
      }
    </script>
  </head>
  <body data-base={base}>
    <slot />
  </body>
</html>
